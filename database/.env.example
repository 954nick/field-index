# -------------------- FIELD INDEX POSTGRESQL CONNECTION --------------------
# Copy this file to database/.env and enter your local PostgreSQL password.
# database/.env is ignored by Git.

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace_with_your_postgres_password
PGDATABASE=field_index

# Usually not required. Set this only if psql cannot be found automatically.
# FIELD_INDEX_PSQL=C:\Program Files\PostgreSQL\18\bin\psql.exe
